# AI Music Showcase — local environment template
# Copy to `.env` for local development. Never commit real secrets.

# Public showcase uses deterministic demo adapters. Production integrations are
# intentionally not included in this repository.
SHOWCASE_MODE=true

NODE_ENV=development
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

API_PORT=3001
API_PUBLIC_URL=http://localhost:3001

# Matches docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_music
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_music
REDIS_URL=redis://localhost:6379

# Local filesystem storage for showcase mode
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_BYTES=104857600

# Development-only auth / security placeholders
AUTH_SECRET=showcase-local-only
API_PROVIDER_REFERENCE_SECRET=showcase-local-only
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
OPS_ADMIN_TOKEN=showcase-local-only
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=showcase-local-only
WORKER_METRICS_ENABLED=true
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9091

# Development authentication. No production identity-provider account required.
AUTH_DEV_MODE=true
AUTH_DEV_USER_EMAIL=dev@local.test
AUTH_DEV_USER_NAME=Demo User
CLERK_SECRET_KEY=replace-me
CLERK_WEBHOOK_SECRET=replace-me

# Demo provider selection. Real production provider credentials and adapter
# configuration are intentionally absent from the public showcase.
MUSIC_DEFAULT_PROVIDER=mock
MUREKA_ENABLED=false
MUREKA_PERSONAL_VOICE_ENABLED=false

# Payments are disabled / mocked in showcase mode.
PAYMENT_PROVIDER=mock
FLITT_ENABLED=false
TBC_CHECKOUT_ENABLED=false
TBC_REFUND_PROVIDER_MODE=mock

# Optional local email integration; not required for the demo.
RESEND_API_KEY=replace-me
TRANSACTIONAL_EMAIL_FROM=noreply@example.com
