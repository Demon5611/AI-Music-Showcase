# AI Music Showcase — environment template
# Copy to `.env` for local development. Never commit real secrets.

# Showcase mode: deterministic demo adapters (no paid AI / payment calls)
SHOWCASE_MODE=true

NODE_ENV=development
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
DATABASE_URL=postgresql://user:password@localhost:5432/ai_music
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/ai_music
REDIS_URL=redis://localhost:6379

# Object storage (local driver for showcase)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
OBJECT_STORAGE_ENDPOINT=https://example.invalid
OBJECT_STORAGE_BUCKET=ai-music-demo
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=ai-music-demo
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=104857600

# Security — use obviously fake placeholders only
AUTH_SECRET=replace-me
API_PROVIDER_REFERENCE_SECRET=replace-me
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
OPS_ADMIN_TOKEN=replace-me
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=replace-me
WORKER_METRICS_ENABLED=true
WORKER_METRICS_HOST=127.0.0.1
WORKER_METRICS_PORT=9091

# Auth (Clerk) — optional when AUTH_DEV_MODE=true
CLERK_SECRET_KEY=replace-me
CLERK_WEBHOOK_SECRET=replace-me
AUTH_DEV_MODE=true
AUTH_DEV_USER_EMAIL=dev@local.test
AUTH_DEV_USER_NAME=Dev User

# AI providers — disabled / unused in SHOWCASE_MODE
MUSIC_DEFAULT_PROVIDER=mock
AI_PROVIDER_API_KEY=replace-me
SUNO_API_KEY=replace-me
SUNO_API_BASE_URL=https://example.invalid
MUREKA_API_KEY=replace-me
MUREKA_BASE_URL=https://example.invalid
MUREKA_ENABLED=false
MUREKA_PERSONAL_VOICE_ENABLED=false
KITS_API_KEY=replace-me
KITS_API_BASE_URL=https://example.invalid

# Payment gateway — disabled by default in showcase
PAYMENT_PROVIDER_SECRET=replace-me
PAYMENT_PROVIDER=flitt
FLITT_ENABLED=false
FLITT_API_BASE_URL=https://example.invalid
FLITT_MERCHANT_ID=
FLITT_PAYMENT_KEY=
FLITT_CURRENCY=GEL
TBC_CHECKOUT_ENABLED=false
TBC_REFUND_PROVIDER_MODE=mock

# Email / ops (optional)
RESEND_API_KEY=replace-me
TRANSACTIONAL_EMAIL_FROM=noreply@example.com
